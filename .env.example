# Example environment file for Everflow AI VFX Platform
# Copy this file to .env and fill in your actual values

# Hugging Face API Token (required for model downloads)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_HUB_TOKEN=hf_your_token_here
HF_TOKEN=hf_your_token_here

# DeepSeek API Keys (optional, for prompt enhancement)
# Required only if using prompt rewriting feature
DEEPSEEK_KEY_ID=your_deepseek_key_id
DEEPSEEK_KEY_SECRET=your_deepseek_secret

# Database Configuration (if using PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost/everflow
DB_HOST=localhost
DB_PORT=5432
DB_NAME=everflow
DB_USER=postgres
DB_PASSWORD=your_password

# Service URLs (for multi-container setup)
HUNYUAN_IMAGE_SERVICE=http://hunyuan-image:4006
HUNYUAN3D_SERVICE=http://hunyuan3d:4007

# GPU Configuration
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

# Python Environment
PYTHONPATH=/app
PYTHONUNBUFFERED=1

# CUDA Memory Configuration (for large models)
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Frontend Configuration
VITE_API_URL=http://localhost:4005

# Optional: Model paths (if using custom locations)
# HUNYUAN_IMAGE_MODEL_PATH=/path/to/model
# HUNYUAN3D_MODEL_PATH=/path/to/model