FROM docker.io/nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

# Install Python and system dependencies
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    git \
    wget \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python packages for Hunyuan3D 2.1
# Using exact versions that work with Hunyuan3D 2.1
RUN pip3 install --no-cache-dir \
    torch==2.1.2 \
    torchvision==0.16.2 \
    torchaudio==2.1.2 \
    xformers==0.0.23.post1 \
    transformers==4.46.0 \
    diffusers==0.30.0 \
    accelerate==1.1.1 \
    safetensors==0.4.4 \
    einops==0.8.0 \
    huggingface-hub>=0.30.2 \
    pillow==10.4.0 \
    numpy==1.24.4 \
    opencv-python==4.10.0.84 \
    rembg==2.0.65 \
    trimesh==4.4.7 \
    pymeshlab==2022.2.post3 \
    pygltflib==1.16.3 \
    open3d==0.18.0 \
    fastapi==0.115.12 \
    uvicorn[standard]==0.34.3 \
    aiofiles==24.1.0 \
    python-multipart==0.0.20 \
    pydantic==2.10.6

# Copy Hunyuan3D model files
COPY backend/Hunyuan3D-2.1 /app/Hunyuan3D-2.1

# Copy the Hunyuan3D API service
COPY backend/hunyuan3d_service.py /app/hunyuan3d_service.py

# Expose port for Hunyuan3D service
EXPOSE 4007

# Start the Hunyuan3D service
CMD ["uvicorn", "hunyuan3d_service:app", "--host", "0.0.0.0", "--port", "4007", "--reload"]