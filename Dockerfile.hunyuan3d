FROM docker.io/nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

# Install Python and system dependencies
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    git \
    wget \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install PyTorch with CUDA support (matching working version)
RUN pip3 install --no-cache-dir \
    torch==2.5.1 \
    torchvision==0.20.1 \
    torchaudio==2.5.1 \
    --index-url https://download.pytorch.org/whl/cu121

# Copy Hunyuan3D model files first
COPY backend/Hunyuan3D-2.1 /app/Hunyuan3D-2.1

# Install Hunyuan3D dependencies from requirements.txt (skip bpy and deepspeed - they're optional)
WORKDIR /app/Hunyuan3D-2.1
RUN grep -v -E "^(bpy==|deepspeed)" requirements.txt > requirements_filtered.txt && \
    pip3 install --no-cache-dir -r requirements_filtered.txt

# Install additional required packages (xformers and flash-attn for efficiency)
RUN pip3 install --no-cache-dir \
    xformers \
    flash-attn \
    --no-build-isolation || true

# Install API service dependencies
RUN pip3 install --no-cache-dir \
    fastapi==0.115.12 \
    uvicorn[standard]==0.34.3 \
    aiofiles==24.1.0 \
    python-multipart==0.0.20 \
    pydantic==2.10.6 \
    rembg==2.0.65 \
    trimesh==4.4.7

# Return to app directory
WORKDIR /app

# Copy the Hunyuan3D API service
COPY backend/hunyuan3d_service.py /app/hunyuan3d_service.py

# Expose port for Hunyuan3D service
EXPOSE 4007

# Start the Hunyuan3D service
CMD ["uvicorn", "hunyuan3d_service:app", "--host", "0.0.0.0", "--port", "4007", "--reload"]