FROM python:3.10-slim

WORKDIR /app

# Install only the minimal requirements for the gateway
RUN pip install --no-cache-dir \
    fastapi==0.115.12 \
    uvicorn[standard]==0.34.3 \
    httpx==0.24.1 \
    pydantic==2.10.6 \
    python-multipart==0.0.20 \
    aiofiles==24.1.0

# Copy only the gateway and necessary files
COPY backend/gateway.py /app/gateway.py
COPY backend/api /app/api

EXPOSE 4005

CMD ["uvicorn", "gateway:app", "--host", "0.0.0.0", "--port", "4005", "--reload"]